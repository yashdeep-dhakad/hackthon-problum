<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.slotbook</groupId>
        <artifactId>slotbook-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>app</artifactId>
    <name>SlotBook app (core + all modules)</name>

    <properties>
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.slotbook</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.slotbook</groupId>
            <artifactId>module-reminders</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.slotbook</groupId>
            <artifactId>module-waitlist</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.slotbook</groupId>
            <artifactId>module-settlement</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.slotbook</groupId>
            <artifactId>module-inbox</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.slotbook.core.SlotBookApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
